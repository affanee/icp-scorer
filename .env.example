# Copy this file to .env and fill in your key.
#   cp .env.example .env
# .env is gitignored. If you ever paste a real key into .env.example, rotate it.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Set this to whichever model id is current in the Anthropic docs.
ANTHROPIC_MODEL=claude-sonnet-4-5
