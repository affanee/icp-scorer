# Copy this file to .env and fill in ONE of the two keys below.
#   cp .env.example .env
# .env is gitignored. If you ever paste a real key into .env.example, rotate it.

# Which provider to score with: "gemini" (free tier) or "anthropic" (paid).
MODEL_PROVIDER=gemini

# --- Option A: Gemini (free tier, no card needed) ---------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Option B: Anthropic (paid) ---------------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
